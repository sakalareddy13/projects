# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection — must match docker-compose.yml postgres service env vars.
# POSTGRES_USER and POSTGRES_DB default to "postgres" in docker-compose.yml,
# but set them explicitly here if you override the defaults.
POSTGRES_PASSWORD=change_me_strong_password
# POSTGRES_USER=postgres          # Postgres username (default: postgres)
# POSTGRES_DB=cost_detective       # Postgres database name (default: postgres)
# DATABASE_URL is constructed from the above in entrypoint.sh; or set directly:
# DATABASE_URL=postgresql://postgres:change_me@postgres:5432/cost_detective

# JWT signing secret — minimum 32 characters.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# If not set, entrypoint.sh auto-generates one and stores it in /app/data/.jwt_secret
# JWT_SECRET=

# ── AI Provider (optional — falls back to rule-based analysis) ────────────────
# Set ONE of these to enable AI-powered cost recommendations:
# ANTHROPIC_API_KEY=sk-ant-...          # Claude
# OPENAI_API_KEY=sk-...                 # GPT-4o
# GOOGLE_API_KEY=...                    # Gemini
# GEMINI_API_KEY=...                    # Gemini (alternative)
# GROQ_API_KEY=...                      # Llama via Groq
# DEEPSEEK_API_KEY=...                  # DeepSeek
# XAI_API_KEY=...                       # Grok
# MISTRAL_API_KEY=...                   # Mistral
# AZURE_OPENAI_API_KEY=...              # Azure OpenAI (+AZURE_OPENAI_ENDPOINT)

# Force a specific provider (optional — auto-detected from keys above)
# AI_PROVIDER=anthropic

# Override the model for the chosen provider (optional)
# AI_MODEL=claude-3-5-sonnet-20241022

# ── AWS (optional — can also be entered in the UI) ────────────────────────────
# AWS_PROFILE=my-sso-profile            # For SSO/Organizations mode
# AWS_ORGANIZATIONS_EXTERNAL_ID=...     # Only needed for cross-org trust

# ── Capacity tuning ───────────────────────────────────────────────────────────
# MAX_CONCURRENT_SCANS=5                # Parallel cloud scans (default 5)
# MAX_ANALYSES_PER_USER=3              # Per-user concurrent limit (default 3)
# SCAN_TASK_TIMEOUT=600                # Per-scan timeout in seconds (default 600)
# ANALYSIS_RETENTION_DAYS=2           # How long to keep analysis results (default 2)

# ── Observability ─────────────────────────────────────────────────────────────
# ENABLE_METRICS=false                  # Expose /metrics (Prometheus) endpoint when true

# ── Runtime ───────────────────────────────────────────────────────────────────
# DEBUG=false                           # Set true only in development
# LOG_FORMAT=json                       # json (default) or text
# UVICORN_WORKERS=1                     # Keep at 1 until Redis replaces in-memory state

# ── Cloudflare Tunnel (optional) ─────────────────────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=...
